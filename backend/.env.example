# Copy to .env and adjust. SQLite needs no setup and is what the test suite
# and local `uvicorn` runs use by default; docker-compose overrides this to
# point at the postgres service.
DATABASE_URL=sqlite:///./predictai.db

# Seconds between simulated sensor ticks per machine.
SIMULATOR_INTERVAL_SECONDS=3

# CORS origin for the Next.js dev server.
FRONTEND_ORIGIN=http://localhost:3000
